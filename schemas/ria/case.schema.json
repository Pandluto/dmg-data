{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ake-cleanroom.local/ria/schemas/case.schema.json",
  "title": "RIA Case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "caseId",
    "title",
    "description",
    "status",
    "createdAt",
    "updatedAt",
    "closedAt",
    "tags",
    "policy"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "caseId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,94}[A-Za-z0-9])?$",
      "minLength": 1,
      "maxLength": 96
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "description": {
      "type": "string",
      "maxLength": 20000
    },
    "status": {
      "enum": [
        "open",
        "closed"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "closedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "resolution": {
      "type": "string",
      "maxLength": 20000
    },
    "tags": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "retentionDays": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "maxRuns": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "compression": {
          "enum": [
            "none",
            "gzip"
          ]
        }
      }
    }
  }
}
