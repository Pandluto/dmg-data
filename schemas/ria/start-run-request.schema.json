{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ake-cleanroom.local/ria/schemas/start-run-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "caseId",
    "sessionId",
    "fixture"
  ],
  "properties": {
    "caseId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,94}[A-Za-z0-9])?$",
      "minLength": 1,
      "maxLength": 96
    },
    "sessionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,94}[A-Za-z0-9])?$",
      "minLength": 1,
      "maxLength": 96
    },
    "runId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,94}[A-Za-z0-9])?$",
      "minLength": 1,
      "maxLength": 96
    },
    "fixture": {
      "type": "object",
      "additionalProperties": true
    },
    "config": {
      "type": "object",
      "additionalProperties": true
    },
    "seed": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "string",
          "maxLength": 512
        },
        {
          "type": "null"
        }
      ]
    },
    "uiActions": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://ake-cleanroom.local/ria/schemas/ui-action-append-request.schema.json",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "actionType"
        ],
        "properties": {
          "actionType": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "actor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "frame": {
            "type": "number",
            "minimum": 0
          },
          "commandId": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  {
                    "type": "number"
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "payload": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    }
  }
}
