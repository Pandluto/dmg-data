{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ake-cleanroom.local/ria/schemas/replay-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "sessionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,94}[A-Za-z0-9])?$",
      "minLength": 1,
      "maxLength": 96
    },
    "replayRunId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,94}[A-Za-z0-9])?$",
      "minLength": 1,
      "maxLength": 96
    }
  }
}
